# Neon PostgreSQL connection string (use the Pooled connection string from Neon Console)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to encrypt user & admin session cookies (MUST be at least 32 random characters)
ACCESS_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Password to unlock /zimadmin and authenticate /api/public/generate-key?token=...
ZIMADMIN_PASSWORD="replace-with-your-strong-admin-password"

# Default Telegram Bot URL for the "Buy Access Key" button on /login (also editable inside /zimadmin)
BUY_KEY_BOT_URL="https://t.me/YourKeyBot"
